{
  "name": "dsh-multipool",
  "version": "0.0.2-rc.3",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "description": "dsh-multipool: one DSH bundle. Host half schedules AMD Radeon Cloud keys, browser half puts the pool on the left sidebar.",
  "main": "./packages/plugin-dsh/dist/index.js",
  "types": "./packages/plugin-dsh/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/plugin-dsh/dist/index.d.ts",
      "default": "./packages/plugin-dsh/dist/index.js"
    },
    "./client": "./packages/client-ui/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "packages/core/dist",
    "packages/plugin-dsh/dist",
    "packages/client-ui/dist",
    "packages/client-ui/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "coverage": "pnpm --filter @dsh-multipool/core coverage",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@dsh-multipool/core": "file:packages/core",
    "@dsh-multipool/plugin-client": "file:packages/client-ui",
    "@dsh-multipool/plugin-dsh": "file:packages/plugin-dsh"
  }
}
