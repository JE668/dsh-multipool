{
  "name": "@dsh-multipool/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Provider-agnostic scheduler core for dsh-multipool. Plain TypeScript, no DSH dependency.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
