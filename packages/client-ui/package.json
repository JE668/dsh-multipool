{
  "name": "@dsh-multipool/plugin-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "dsh-multipool browser half: left sidebar icon, badge density and the tooltip's three lines.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test test/*.test.mjs",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@dsh-multipool/core": "workspace:*"
  }
}
