{
  "name": "@dsh-multipool/plugin-dsh",
  "version": "0.0.2-rc.3",
  "private": true,
  "type": "module",
  "description": "dsh-multipool Host plugin: AMD adapter wiring, local proxy, settings section, data contract.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@dsh-multipool/core": "workspace:*",
    "@dsh-multipool/plugin-client": "workspace:*"
  }
}
